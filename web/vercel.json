{
  "version": 2,
  "routes": [
    { "src": "/api/events", "dest": "/api/events.js" },
    { "src": "/api/accounts", "dest": "/api/accounts.js" },
    { "src": "/api/keys", "dest": "/api/keys.js" },
    { "src": "/api/admin-keys", "dest": "/api/admin-keys.js" },
    { "src": "/api/link-key", "dest": "/api/link-key.js" },
